# ---- Общее ----
SECRET_KEY=сгенерируй-длинную-случайную-строку
INVITE_CODE=придумай-код-который-дашь-знакомым

# ---- Сценарий (Anthropic) ----
ANTHROPIC_API_KEY=sk-ant-...

# ---- Кадры + видео (Google Gemini: Nano Banana / Veo) ----
GOOGLE_API_KEY=AI...
IMAGE_MODEL=gemini-2.5-flash-image
VIDEO_MODEL=veo-3.1-generate-preview

# ---- Озвучка (ElevenLabs) ----
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=...

# ---- Вход через Google ----
# Google Cloud Console -> Credentials -> OAuth client ID -> Web application
# Authorized JavaScript origins: твой домен (и http://localhost:8000 для теста)
GOOGLE_OAUTH_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# ---- Вход через Telegram ----
# Создай бота через @BotFather, затем выполни /setdomain и укажи свой домен —
# без этого виджет входа не заработает.
TELEGRAM_BOT_TOKEN=123456:AA...
TELEGRAM_BOT_USERNAME=your_bot_name

# ---- Оплата (Stripe) ----
STRIPE_SECRET_KEY=sk_live_или_sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
STRIPE_SUCCESS_URL=http://localhost:8000/?checkout=success
STRIPE_CANCEL_URL=http://localhost:8000/?checkout=cancel
